{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Central user account document containing all game state, settings, inventory, and cats.",
      "type": "object",
      "properties": {
        "nickname": { "type": "string", "maxLength": 100 },
        "paws": { "type": "integer" },
        "theme": { "type": "string", "enum": ["light", "dark", "auto"] },
        "currentWallpaper": { "type": "string" },
        "soundEnabled": { "type": "boolean" },
        "streak": { "type": "integer" },
        "foodCount": { "type": "integer" },
        "soapCount": { "type": "integer" },
        "fishCount": { "type": "integer" },
        "energyCount": { "type": "integer" },
        "cats": { "type": "array" },
        "unlockedSkins": { "type": "array" },
        "quests": { "type": "array" },
        "unlockedAchievements": { "type": "array" },
        "totalPlayTime": { "type": "integer" },
        "totalInteractions": { "type": "integer" },
        "clicksCount": { "type": "integer" },
        "popItBurstedCount": { "type": "integer" },
        "keyboardClicksCount": { "type": "integer" },
        "diary": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "lastSavedTime": { "type": "number" },
        "claimedReviewReward": { "type": "boolean" },
        "isAdmin": { "type": "boolean" },
        "blocked": { "type": "boolean" }
      },
      "required": ["nickname", "paws", "cats", "unlockedSkins", "streak", "foodCount", "soapCount"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "All players including Google Auth users and local-identified users are persisted here."
    }
  }
}
