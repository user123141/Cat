rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.nickname is string && data.nickname.size() <= 100
        && data.paws is int && data.paws >= 0
        && data.cats is list
        && data.unlockedSkins is list
        && data.streak is int && data.streak >= 0
        && data.foodCount is int && data.foodCount >= 0
        && data.soapCount is int && data.soapCount >= 0;
    }

    // 2. Users Collection Matches
    match /users/{userId} {
      allow read: if isOwner(userId) || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      
      allow create: if isOwner(userId) 
        && isValidId(userId) 
        && isValidUser(incoming())
        && (!incoming().keys().hasAll(['isAdmin']) || incoming().isAdmin == false)
        && (!incoming().keys().hasAll(['blocked']) || incoming().blocked == false);
        
      allow update: if isOwner(userId) 
        && isValidUser(incoming())
        && incoming().nickname == existing().nickname
        && (!incoming().keys().hasAll(['isAdmin']) || incoming().isAdmin == existing().isAdmin)
        && (!incoming().keys().hasAll(['blocked']) || incoming().blocked == existing().blocked);
        
      allow delete: if isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admins Collection Matches
    match /admins/{adminId} {
      allow read, write: if false;
    }
  }
}
